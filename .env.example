# These are examples only; no file is loaded automatically.
# Local PowerShell: set the corresponding $env:NAME values explicitly.
APP_ENV=local
DATABASE_URL=sqlite:///data/galatalkka.db
APP_LOCAL_TOKEN=
CORS_ORIGINS=http://localhost:5173
PORT=8765
# Railway: APP_ENV=staging and DATABASE_URL referencing the PostgreSQL service.
# Set APP_LOCAL_TOKEN to a random value of at least 32 characters.
# CORS_ORIGINS must list the actual frontend origins without a wildcard.
